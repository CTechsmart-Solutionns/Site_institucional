---
// Assinatura horizontal: símbolo + "CTechsmart" + "SOLUTIONS" (Manual de Marca, seção 02).
interface Props {
  variant?: 'light' | 'dark';
  size?: 'md' | 'sm';
}
const { variant = 'light', size = 'md' } = Astro.props;
const stroke = variant === 'dark' ? '#FFFFFF' : '#0B1F33';
const accent = variant === 'dark' ? '#67E8F9' : '#0E7490';
---

<span class:list={['logo', `logo--${variant}`, `logo--${size}`]}>
  <svg class="logo__mark" viewBox="4 6 50 52" fill="none" aria-hidden="true">
    <path
      d="M47.56 16.44 L22.7 12.07 L10 32 L22.7 51.93 L47.56 47.56 M10 32 H38"
      stroke={stroke}
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <circle cx="22.7" cy="12.07" r="4.5" fill={stroke}></circle>
    <circle cx="10" cy="32" r="5" fill={stroke}></circle>
    <circle cx="22.7" cy="51.93" r="4.5" fill={stroke}></circle>
    <circle cx="47.56" cy="16.44" r="5.5" fill={accent}></circle>
    <circle cx="47.56" cy="47.56" r="5.5" fill={accent}></circle>
    <circle cx="40" cy="32" r="5.5" fill={accent}></circle>
  </svg>
  <span class="logo__text">
    <span class="logo__name"><b>CTech</b><span class="logo__smart">smart</span></span>
    <span class="logo__solutions">SOLUTIONS</span>
  </span>
</span>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .logo__mark {
    width: 38px;
    height: 40px;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .logo__name {
    font-size: 19px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-marinho);
  }
  .logo__name b {
    font-weight: 700;
  }
  .logo__smart {
    font-weight: 400;
    color: var(--c-petroleo);
  }
  .logo__solutions {
    font-size: 6px;
    font-weight: 600;
    letter-spacing: 0.42em;
    color: var(--c-ardosia);
  }
  .logo--dark .logo__name {
    color: var(--c-branco);
  }
  .logo--dark .logo__smart {
    color: var(--c-ciano);
  }
  .logo--dark .logo__solutions {
    color: var(--c-cinza-claro);
  }
  .logo--sm .logo__mark {
    width: 34px;
    height: 35px;
  }
  .logo--sm .logo__name {
    font-size: 17px;
  }
  .logo--sm .logo__solutions {
    font-size: 5px;
  }
</style>
