---
import type { IconName } from '../data/solutions';

interface Props {
  name: IconName | 'check' | 'whatsapp' | 'mail';
  size?: number;
  color?: string;
  strokeWidth?: number;
}
const { name, size = 24, color = 'currentColor', strokeWidth = 2 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'chat' && (
      <>
        <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />
        <path d="M8.5 11h.01M12 11h.01M15.5 11h.01" />
      </>
    )
  }
  {
    name === 'calendar' && (
      <>
        <rect x="3" y="5" width="18" height="16" rx="3" />
        <path d="M8 3v4M16 3v4M3 10h18" />
        <path d="M9 15l2 2 4-4" />
      </>
    )
  }
  {name === 'chart' && <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === 'whatsapp' && <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />}
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </>
    )
  }
</svg>
