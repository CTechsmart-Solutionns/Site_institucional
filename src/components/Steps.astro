---
import { steps } from '../data/site';
---

<ol class="steps">
  {
    steps.map((step, i) => (
      <li class="step">
        <span class="step__n" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="step__title">{step.title}</h3>
        <p class="muted">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .step {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 3px solid var(--c-petroleo);
    padding-top: 24px;
  }
  .step__n {
    font-size: 15px;
    font-weight: 700;
    color: var(--c-petroleo);
  }
  .step__title {
    font-size: 21px;
  }
</style>
