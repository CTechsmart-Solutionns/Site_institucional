---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<div class="section-header">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="h2">{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 680px;
  }
</style>
