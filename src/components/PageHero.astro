---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  breadcrumbs: Crumb[];
  eyebrow: string;
  title: string;
  intro: string;
  /** Exibe os botões de demonstração/soluções. */
  ctas?: boolean;
}
const { breadcrumbs, eyebrow, title, intro, ctas = true } = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero__inner">
    <Breadcrumbs items={breadcrumbs} />
    {Astro.slots.has('brand') && <div class="page-hero__brand"><slot name="brand" /></div>}
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-hero__title">{title}</h1>
    <p class="page-hero__intro">{intro}</p>
    {
      ctas && (
        <div class="page-hero__ctas">
          <a href="#contato" class="btn btn--primary">Agendar demonstração</a>
          <a href="/#solucoes" class="btn btn--secondary">Ver todas as soluções</a>
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    background: var(--c-nevoa);
  }
  .page-hero__inner {
    padding-top: 48px;
    padding-bottom: 88px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .page-hero__inner :global(.crumbs) {
    margin-bottom: 24px;
  }
  .page-hero__brand :global(img) {
    width: 240px;
    height: auto;
  }
  .page-hero__title {
    font-size: 46px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
    max-width: 820px;
  }
  .page-hero__intro {
    font-size: 19px;
    color: var(--c-ardosia);
    max-width: 640px;
  }
  .page-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
  @media (max-width: 720px) {
    .page-hero__inner {
      padding-top: 32px;
      padding-bottom: 64px;
    }
    .page-hero__title {
      font-size: 34px;
    }
    .page-hero__intro {
      font-size: 17px;
    }
  }
</style>
