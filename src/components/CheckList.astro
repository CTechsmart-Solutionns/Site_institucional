---
import Icon from './Icon.astro';

interface Props {
  items: string[];
  dark?: boolean;
}
const { items, dark = false } = Astro.props;
---

<ul class="checks">
  {
    items.map((item) => (
      <li>
        <Icon name="check" size={20} strokeWidth={2.5} color={dark ? '#67E8F9' : '#0E7490'} />
        {item}
      </li>
    ))
  }
</ul>

<style>
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
  }
  .checks li {
    display: flex;
    gap: 10px;
  }
  .checks :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>
