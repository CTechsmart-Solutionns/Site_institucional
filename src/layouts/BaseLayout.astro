---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, whatsappIntl } from '../data/site';
import soraBold from '@fontsource/sora/files/sora-latin-700-normal.woff2?url';
import type { Crumb } from '../components/Breadcrumbs.astro';

interface Props {
  /** Título da página, sem o nome da empresa (≤ 60 caracteres no total). */
  title: string;
  /** Meta description (≤ 155 caracteres). */
  description: string;
  /** Usa `title` como está, sem o sufixo " | CTechsmart". */
  fullTitle?: boolean;
  /** Gera BreadcrumbList no JSON-LD. */
  breadcrumbs?: Crumb[];
  /** Blocos JSON-LD adicionais da página. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description,
  fullTitle = false,
  breadcrumbs,
  jsonLd = [],
  noindex = false,
  ogImage = '/og-image.png',
} = Astro.props;

const siteUrl = Astro.site!;
const pageTitle = fullTitle ? title : `${title} | CTechsmart`;
// No build (format: 'file') o pathname vem com ".html"; a URL pública não tem extensão.
const canonicalPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(canonicalPath, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', siteUrl).href,
  name: site.name,
  legalName: site.legalName,
  ...(site.cnpj && { taxID: site.cnpj }),
  ...(site.address && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.state,
      postalCode: site.address.postalCode,
      addressCountry: 'BR',
    },
  }),
  url: siteUrl.href,
  logo: new URL('/logo.png', siteUrl).href,
  description: site.description,
  areaServed: 'BR',
  ...(site.sameAs.length && { sameAs: site.sameAs }),
  ...((site.contact.email || site.contact.whatsapp) && {
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      availableLanguage: 'Portuguese',
      ...(site.contact.email && { email: site.contact.email }),
      ...(whatsappIntl && { telephone: `+${whatsappIntl}` }),
    },
  }),
};

const breadcrumbLd = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, siteUrl).href,
  })),
};

const allJsonLd = [organization, ...(breadcrumbLd ? [breadcrumbLd] : []), ...jsonLd];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <!-- Sem JS o menu mobile fica aberto (ver Header.astro). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Só o peso do h1 (LCP); 400 e 600 seguem pelo CSS. -->
    <link rel="preload" href={soraBold} as="font" type="font/woff2" crossorigin />

    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B1F33" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {allJsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
